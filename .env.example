# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/getro_jobs?schema=public"

# Authentication and email are not wired yet; configure only with the chosen providers.
AUTH_SECRET="replace-with-a-cryptographically-random-secret"
AUTH_URL="http://localhost:3000"
EMAIL_FROM="jobs@example.com"
EMAIL_API_KEY=""
REDIS_URL="redis://localhost:6379"

# Set true only after a production admin bootstrap process exists.
ENABLE_ADMIN_SETUP="false"
